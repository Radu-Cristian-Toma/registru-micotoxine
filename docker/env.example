# Copiați acest fișier ca „.env” lângă docker-compose.yml și completați. Fișierul .env nu se pune în depozit.

# Numele DNS al serverului (HTTPS). Implicit „localhost” (certificat local, pentru încercare).
LIMS_DOMAIN=localhost

# Primul administrator: la prima pornire se creează contul, cu o parolă temporară aleatoare
# afișată o singură dată în jurnal:  docker compose logs lims
LIMS_ADMIN_EMAIL=
# LIMS_ADMIN_NAME=

# Parola copiilor de siguranță criptate (minimum 12 caractere); păstrați-o separat de copii.
# LIMS_BACKUP_PASSPHRASE=

# Adresa codului sursă oferit utilizatorilor (AGPL-3.0, art. 13), dacă ați modificat programul.
# LIMS_SOURCE_URL=

# Porturi publicate (implicit 80 și 443).
# LIMS_HTTP_PORT=80
# LIMS_HTTPS_PORT=443
